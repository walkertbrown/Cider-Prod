// Committed template. The real KV id lives in wrangler.local.jsonc (gitignored):
// deploy with `npx wrangler@4 deploy -c wrangler.local.jsonc`.
{
  "name": "comiccover-demo",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "kv_namespaces": [{ "binding": "COVERS", "id": "<kv-id>" }],
